\name{withargs}
\alias{withargs}
\title{A Topic With Several Arguments}
\description{
  Demonstrates an arguments section with multiple item entries, which
  stresses repeated Rd_tag and attribute-symbol reuse across many sibling
  nodes.
}
\usage{
withargs(x, y, z, verbose = FALSE, \dots)
}
\arguments{
  \item{x}{the first argument}
  \item{y}{the second argument}
  \item{z}{the third argument}
  \item{verbose}{logical; print progress}
  \item{\dots}{further arguments passed to methods}
}
