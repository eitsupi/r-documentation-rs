\name{composite-function}
\alias{composite_function}
\title{A small composite function}
\description{This function combines values and reports a result.}
\usage{
composite_function(x, y = 1, ..., verbose = FALSE)
}
\arguments{
  \item{x}{A numeric input.}
  \item{y}{A scaling value.}
  \item{...}{Additional arguments.}
  \item{verbose}{Whether to report progress.}
}
\value{A numeric result.}
\examples{
composite_function(2, y = 3)
}
